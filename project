    document.querySelectorAll('.region-tab').forEach(btn => {
      btn.addEventListener('click', () => selectRegion(btn.dataset.region));
    });

    // =========================================================================
    // 2. INTERACTIVE GARMENT QUOTATION & COSTING ENGINE
    // =========================================================================
    const currencyConfig = {
      USD: { symbol: '$', rate: 1.00 },
      EUR: { symbol: '€', rate: 0.92 },
      CAD: { symbol: 'CA$', rate: 1.38 },
      GBP: { symbol: '£', rate: 0.79 }
    };

    let state = {
      currency: 'USD',
      categoryName: 'Heavy Knitwear',
      baseCategoryPrice: 9.50,
      uploadedFile: null,
      lastCalculated: {}
    };

    function formatMoney(usdAmount, decimals = 2) {
      const cfg = currencyConfig[state.currency];
      const converted = usdAmount * cfg.rate;
      return cfg.symbol + converted.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function calculateQuote() {
      // 1. Gather Size Matrix Units
      let totalUnits = 0;
      const sizeBreakdown = {};
      document.querySelectorAll('.size-input').forEach(input => {
        const qty = Math.max(0, parseInt(input.value, 10) || 0);
        sizeBreakdown[input.dataset.size] = qty;
        totalUnits += qty;
      });

      // MOQ warning toggle
      const moqWarning = document.getElementById('moqWarning');
      if (totalUnits < 300) {
        moqWarning.classList.remove('hidden');
      } else {
        moqWarning.classList.add('hidden');
      }

      // 2. Fabric Multiplier & GSM Weight Adjustment
      const fabricSelect = document.getElementById('fabricType');
      const fabricMult = parseFloat(fabricSelect.selectedOptions[0].dataset.mult || 1.0);
      const gsm = parseInt(document.getElementById('fabricGsm').value, 10);
      document.getElementById('gsmDisplay').textContent = gsm;

      // Baseline GSM is 240; heavier fabrics add yarn consumption cost
      const gsmDeltaCost = Math.max(0, (gsm - 240) * 0.0085);
      const fabricAdjustment = (state.baseCategoryPrice * (fabricMult - 1)) + gsmDeltaCost;

      // 3. Wash / Dyeing Addon
      const finishSelect = document.getElementById('fabricFinish');
      const washCost = parseFloat(finishSelect.selectedOptions[0].dataset.addon || 0);

      // 4. Trims & Embellishments
      let trimsCost = 0;
      const selectedTrims = [];
      document.querySelectorAll('.trim-checkbox:checked').forEach(cb => {
        trimsCost += parseFloat(cb.dataset.cost || 0);
        selectedTrims.push(cb.dataset.trim);
      });

      // Subtotal before volume tiering
      const rawUnitCost = state.baseCategoryPrice + fabricAdjustment + washCost + trimsCost;

      // 5. Volume Tier Discount / Small-Batch Surcharge
      let discountRate = 0;
      let tierLabel = 'Standard Tier';
      let tierNote = 'Standard MOQ pricing';

      if (totalUnits < 300) {
        discountRate = -0.18; // 18% surcharge for micro-run
        tierLabel = 'Micro-Run (+18%)';
        tierNote = 'Under 300 pcs capsule surcharge';
      } else if (totalUnits >= 5000) {
        discountRate = 0.14;
        tierLabel = 'Tier 4 (-14%)';
        tierNote = 'Includes 14% factory bulk rebate';
      } else if (totalUnits >= 3000) {
        discountRate = 0.10;
        tierLabel = 'Tier 3 (-10%)';
        tierNote = 'Includes 10% volume rebate';
      } else if (totalUnits >= 1000) {
        discountRate = 0.06;
        tierLabel = 'Tier 2 (-6%)';
        tierNote = 'Includes 6% volume rebate';
      }

      const discountAmount = rawUnitCost * discountRate;
      const finalUnitFOB = Math.max(1, rawUnitCost - discountAmount);
      const totalOrderFOB = finalUnitFOB * totalUnits;

      // Update UI Elements
      const styleTitle = document.getElementById('styleName').value.trim() || 'Custom Apparel Style';
      document.getElementById('summaryStyleTitle').textContent = styleTitle;
      document.getElementById('tierBadge').textContent = tierLabel;
      document.getElementById('unitPriceDisplay').textContent = formatMoney(finalUnitFOB, 2);
      document.getElementById('volumeDiscountNote').textContent = tierNote;
      document.getElementById('totalUnitsDisplay').textContent = totalUnits.toLocaleString();
      document.getElementById('protoSampleEst').textContent = `Proto Sample: ${formatMoney(65, 0)} (Credited)`;

      document.getElementById('breakdownBase').textContent = formatMoney(state.baseCategoryPrice, 2);
      document.getElementById('breakdownFabric').textContent = '+' + formatMoney(fabricAdjustment, 2);
      document.getElementById('breakdownWash').textContent = '+' + formatMoney(washCost, 2);
      document.getElementById('breakdownTrims').textContent = '+' + formatMoney(trimsCost, 2);
      document.getElementById('breakdownDiscount').textContent =
        discountAmount >= 0
          ? '-' + formatMoney(discountAmount, 2)
          : '+' + formatMoney(Math.abs(discountAmount), 2);

      document.getElementById('totalOrderValueDisplay').textContent = formatMoney(totalOrderFOB, 0);

      // Save state for modal / submission
      state.lastCalculated = {
        styleName: styleTitle,
        category: state.categoryName,
        fit: document.getElementById('garmentFit').value,
        fabric: fabricSelect.value,
        gsm: gsm,
        finish: finishSelect.value,
        colorways: document.getElementById('colorways').value,
        sizeBreakdown,
        totalUnits,
        selectedTrims,
        unitFOBFormatted: formatMoney(finalUnitFOB, 2),
        totalFOBFormatted: formatMoney(totalOrderFOB, 0),
        unitFOBUsd: finalUnitFOB,
        totalFOBUsd: totalOrderFOB
      };
    }

    // Category Card Selection
    document.querySelectorAll('.cat-card').forEach(card => {
