  <style>
    :root {
      --bg-canvas: #F8F7F4;
      --ink-primary: #121820;
      --accent-terracotta: #B85D3B;
      --accent-navy: #172334;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--ink-primary);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Subtle editorial paper texture & grid pattern */
    .editorial-grid {
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(23, 35, 52, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(23, 35, 52, 0.03) 1px, transparent 1px);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #EFECE6;
    }
    ::-webkit-scrollbar-thumb {
      background: #C4BEB3;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #9E978B;
    }

    /* Pulse animation for global hub nodes */
    @keyframes hubPulse {
      0% { transform: scale(0.95); opacity: 0.85; }
      70% { transform: scale(2.1); opacity: 0; }
      100% { transform: scale(2.1); opacity: 0; }
    }
    .hub-ring {
      animation: hubPulse 2.6s infinite cubic-bezier(0.24, 0, 0.38, 1);
      transform-origin: center;
      transform-box: fill-box;
    }

    /* Print styling for formal Quotation / Tech Sheet */
    @media print {
      body * {
        visibility: hidden;
      }
      #techSheetModal, #techSheetModal * {
        visibility: visible;
      }
      #techSheetModal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="antialiased selection:bg-meridian-terracotta selection:text-white">

