        }
      });

      // Highlight SVG Arc
      ['usa', 'canada', 'italy', 'uk', 'eu'].forEach(key => {
        const arc = document.getElementById(`arc-${key}`);
        if (arc) {
          arc.setAttribute('stroke', key === regionKey ? '#B85D3B' : '#C5A059');
          arc.setAttribute('stroke-width', key === regionKey ? '3' : '1.6');
