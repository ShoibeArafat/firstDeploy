      const ratios = { XS: 0.07, S: 0.17, M: 0.30, L: 0.27, XL: 0.13, XXL: 0.06 };
      document.querySelectorAll('.size-input').forEach(input => {
        const size = input.dataset.size;
        input.value = Math.round((targetTotal * ratios[size]) / 10) * 10;
